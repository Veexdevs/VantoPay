# ───────────────────────────────────────────────────────────────────────────
# VantoPay — Environment variables
#
# Copy this file to `.env` (backend) and configure the build-time variables for
# the app. NEVER commit real credentials. Use GitHub Secrets and Vercel
# encrypted environment variables for private values.
# ───────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
VANTOPAY_ENV=development
VANTOPAY_DEBUG=false
# Public origin of the backend (used for CORS). List comma-separated origins.
VANTOPAY_PUBLIC_ORIGIN=http://localhost:8000,http://localhost:3000

# ── Backend API ─────────────────────────────────────────────────────────────
VANTOPAY_API_URL=http://localhost:8000

# ── Database (PostgreSQL / Supabase) ────────────────────────────────────────
# Local dev defaults to SQLite. Point to Supabase Postgres for production.
DATABASE_URL=postgresql://user:password@db.host:5432/vantopay
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Supabase Auth ───────────────────────────────────────────────────────────
# From the Supabase project dashboard (Settings → API).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Service role key — ONLY for the backend, never in the frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# JWT secret used to verify Supabase access tokens (Settings → API → JWT secret).
SUPABASE_JWT_SECRET=YOUR-JWT-SECRET
SUPABASE_JWT_ISSUER=

# ── Google OAuth (provider configured in Supabase) ──────────────────────────
GOOGLE_CLIENT_ID=

# ── Payment Gateway — HyperSwitch (juspay/hyperswitch) ──────────────────────
HYPERSWITCH_URL=
HYPERSWITCH_API_KEY=
HYPERSWITCH_MERCHANT_ID=

# ── Payment Infrastructure — Moov (moov-io/moov-io) ──────────────────────────
MOOV_BASE_URL=
MOOV_TOKEN=

# ── Financial Ledger — Formance (formancehq/ledger) ─────────────────────────
FORMANCE_BASE_URL=
FORMANCE_API_KEY=

# ── Core Banking — Fineract (apache/fineract) ───────────────────────────────
FINERACT_BASE_URL=
FINERACT_USERNAME=
FINERACT_PASSWORD=

# ── PIX Provider (authorized participant / processor) ───────────────────────
PIX_PROVIDER_BASE_URL=
PIX_PROVIDER_TOKEN=

# ── Security ─────────────────────────────────────────────────────────────────
# Secret used to sign internal service-to-service idempotency receipts.
VANTOPAY_SERVICE_SECRET=
VANTOPAY_SESSION_TTL_MINUTES=720
VANTOPAY_RATE_LIMIT_PER_MINUTE=30
VANTOPAY_SUSPICION_THRESHOLD=50

# ── Flutter app build-time variables (--dart-define) ─────────────────────────
# Injected at build time, e.g.:
#   flutter build web --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
#   flutter build apk --dart-define=SUPABASE_URL=...
SUPABASE_URL=
SUPABASE_ANON_KEY=
VANTOPAY_API_URL=
GOOGLE_CLIENT_ID=
